# Web server configuration
PORT=8080
HOST=0.0.0.0

# Database configuration
DATABASE_PATH=data/db

# Backup configuration
BACKUP_USE_AWS=false
BACKUP_S3_BUCKET=your-s3-bucket-name
BACKUP_S3_PREFIX=backups
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SESSION_TOKEN=your_aws_session_token_if_needed
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/YourRole

# Local backup settings (when AWS is not used)
BACKUP_LOCAL_DIR=./backups
BACKUP_LOCAL_MAX_COUNT=10
BACKUP_ENVIRONMENT=dev
BACKUP_SERVER_ID=server1
BACKUP_INTERVAL_SECONDS=300
BACKUP_SHUTDOWN_TIMEOUT_SECONDS=30
BACKUP_FORCE_RESTORATION=false
BACKUP_SKIP_RESTORATION_IF_NO_BACKUPS=true

# Spotify OAuth credentials
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
